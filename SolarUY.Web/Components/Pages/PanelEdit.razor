@page "/paneles/editar/{Id:guid}"
@page "/paneles/{Id:guid}/editar"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using SolarUY.Web.Services
@inject PanelsApiClient PanelsClient
@inject SolarParkApiClient SolarParkClient
@inject NavigationManager Navigation

<PageTitle>Modificar Panel Solar — SolarUY</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            @if (_isLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary me-2" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <span class="text-muted">Cargando datos del panel...</span>
                </div>
            }
            else if (_notFound)
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <div class="mb-3 text-warning">
                            <span class="bi bi-exclamation-circle fs-1" aria-hidden="true"></span>
                        </div>
                        <h5 class="card-title text-secondary">El panel solicitado no existe.</h5>
                        <p class="card-text text-muted mb-4">El identificador proporcionado no corresponde a ningún panel registrado.</p>
                        <a href="/paneles" class="btn btn-outline-primary">
                            <span class="bi bi-arrow-left me-1"></span> Volver al listado
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                        <h3 class="card-title h5 mb-0 d-flex align-items-center">
                            <span class="bi bi-pencil-square me-2" aria-hidden="true"></span>
                            Modificar Panel Solar
                        </h3>
                        @if (_currentStatus != null)
                        {
                            <span class="badge @(_currentStatus == "Activo" ? "bg-success" : "bg-secondary")">
                                Estado: @_currentStatus
                            </span>
                        }
                    </div>
                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                                <span class="bi bi-exclamation-triangle-fill me-2"></span>
                                <div>@_errorMessage</div>
                                <button type="button" class="btn-close" @onclick="() => _errorMessage = null" aria-label="Cerrar"></button>
                            </div>
                        }

                        <EditForm Model="@_formModel" OnValidSubmit="HandleSubmitAsync">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="serieNumber" class="form-label fw-semibold">Número de Serie <span class="text-danger">*</span></label>
                                <InputText id="serieNumber" class="form-control" placeholder="Ej: PNL-2026-001" @bind-Value="_formModel.SerieNumber" />
                                <ValidationMessage For="@(() => _formModel.SerieNumber)" class="text-danger small mt-1" />
                                <div class="form-text small">Hasta 50 caracteres, único en el sistema.</div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label for="powerW" class="form-label fw-semibold">Potencia (W) <span class="text-danger">*</span></label>
                                    <InputNumber id="powerW" class="form-control" placeholder="450" @bind-Value="_formModel.PowerW" />
                                    <ValidationMessage For="@(() => _formModel.PowerW)" class="text-danger small mt-1" />
                                    <div class="form-text small">Número entero mayor a 0</div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label for="efficiency" class="form-label fw-semibold">Eficiencia (%) <span class="text-danger">*</span></label>
                                    <InputNumber id="efficiency" class="form-control" placeholder="21.5" @bind-Value="_formModel.Efficiency" step="any" />
                                    <ValidationMessage For="@(() => _formModel.Efficiency)" class="text-danger small mt-1" />
                                    <div class="form-text small">Mayor a 0 y hasta 100%</div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="solarParkId" class="form-label fw-semibold">Parque Solar <span class="text-danger">*</span></label>
                                @if (_loadingParks)
                                {
                                    <div class="d-flex align-items-center text-muted small py-2">
                                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                        <span>Cargando parques...</span>
                                    </div>
                                }
                                else
                                {
                                    <InputSelect id="solarParkId" class="form-select" @bind-Value="_formModel.SolarParkId">
                                        <option value="">Seleccioná un parque solar...</option>
                                        @foreach (var park in _parks)
                                        {
                                            <option value="@park.Id">@park.Name</option>
                                        }
                                    </InputSelect>
                                }
                                <ValidationMessage For="@(() => _formModel.SolarParkId)" class="text-danger small mt-1" />
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <a href="/paneles" class="btn btn-outline-secondary px-3">
                                    Cancelar
                                </a>
                                <button type="submit" class="btn btn-primary px-4 d-flex align-items-center" disabled="@_isSubmitting">
                                    @if (_isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Guardando...</span>
                                    }
                                    else
                                    {
                                        <span class="bi bi-save me-1" aria-hidden="true"></span>
                                        <span>Guardar Cambios</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private PanelEditFormModel _formModel = new();
    private bool _isLoading = true;
    private bool _notFound;
    private bool _isSubmitting;
    private bool _loadingParks;
    private string? _errorMessage;
    private string? _currentStatus;
    private List<SolarParkDto> _parks = [];

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _notFound = false;
        _errorMessage = null;

        try
        {
            var panel = await PanelsClient.GetByIdAsync(Id);
            if (panel == null)
            {
                _notFound = true;
                return;
            }

            _currentStatus = panel.Status;
            _formModel = new PanelEditFormModel
            {
                SerieNumber = panel.SerieNumber,
                PowerW = panel.PowerW,
                Efficiency = panel.Efficiency,
                SolarParkId = panel.SolarParkId != Guid.Empty ? panel.SolarParkId : null
            };

            await LoadParksAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al cargar el panel: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadParksAsync()
    {
        _loadingParks = true;
        try
        {
            var allParks = await SolarParkClient.GetAllAsync();
            _parks = allParks.Where(p => p.Status == "Activo").ToList();

            // Si el parque actual está inactivo, mantenerlo en la lista para que se muestre en el dropdown
            if (_formModel.SolarParkId.HasValue && !_parks.Any(p => p.Id == _formModel.SolarParkId.Value))
            {
                var currentPark = allParks.FirstOrDefault(p => p.Id == _formModel.SolarParkId.Value);
                if (currentPark != null)
                {
                    _parks.Add(currentPark);
                }
            }
        }
        catch
        {
            _parks = [];
        }
        finally
        {
            _loadingParks = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;

        if (!_formModel.SolarParkId.HasValue || _formModel.SolarParkId.Value == Guid.Empty)
        {
            _errorMessage = "El parque solar seleccionado no existe o no está activo.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var dto = new UpdateSolarPanelDto(
                _formModel.SerieNumber ?? string.Empty,
                _formModel.PowerW ?? 0,
                _formModel.Efficiency ?? 0,
                _formModel.SolarParkId.Value
            );

            var result = await PanelsClient.UpdateAsync(Id, dto);

            if (result.Success)
            {
                Navigation.NavigateTo($"/paneles?mensaje={Uri.EscapeDataString("Panel actualizado correctamente.")}");
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class PanelEditFormModel
    {
        [Required(ErrorMessage = "El número de serie es obligatorio.")]
        [StringLength(50, ErrorMessage = "El número de serie no puede superar los 50 caracteres.")]
        public string? SerieNumber { get; set; }

        [Required(ErrorMessage = "La potencia debe ser mayor a 0.")]
        [Range(1, int.MaxValue, ErrorMessage = "La potencia debe ser mayor a 0.")]
        public int? PowerW { get; set; }

        [Required(ErrorMessage = "La eficiencia debe ser mayor a 0.")]
        [Range(0.0001, 100.0, ErrorMessage = "La eficiencia debe ser mayor a 0 y no puede superar el 100.")]
        public double? Efficiency { get; set; }

        [Required(ErrorMessage = "El parque solar seleccionado no existe o no está activo.")]
        public Guid? SolarParkId { get; set; }
    }
}
