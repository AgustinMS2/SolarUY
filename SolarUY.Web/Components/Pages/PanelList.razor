@page "/paneles"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Any)]
@using SolarUY.Web.Services
@inject PanelsApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Listado de Paneles Solares — SolarUY</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-primary d-flex align-items-center">
                <span class="bi bi-grid-3x3-gap-fill me-2" aria-hidden="true"></span>
                Paneles Solares
            </h1>
            <p class="text-muted mb-0">Gestión y estado operativo de paneles fotovoltaicos.</p>
        </div>
        <AuthorizeView Roles="@AppRoles.Administrator">
            <div>
                <a href="/paneles/nuevo" class="btn btn-primary d-flex align-items-center">
                    <span class="bi bi-plus-circle me-1" aria-hidden="true"></span>
                    <span>Nuevo panel</span>
                </a>
            </div>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrEmpty(Mensaje))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <span class="bi bi-check-circle-fill me-2"></span>
            <div>@Mensaje</div>
            <button type="button" class="btn-close" @onclick="() => Mensaje = null" aria-label="Cerrar"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary me-2" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <span class="text-muted">Cargando listado de paneles...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center">
                <span class="bi bi-exclamation-triangle-fill me-2 fs-5"></span>
                <div>@_errorMessage</div>
            </div>
            <button class="btn btn-outline-danger btn-sm" @onclick="LoadPanelsAsync">
                <span class="bi bi-arrow-clockwise me-1"></span> Reintentar
            </button>
        </div>
    }
    else if (_panels == null || _panels.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="mb-3 text-muted">
                    <span class="bi bi-inbox fs-1" aria-hidden="true"></span>
                </div>
                <h5 class="card-title text-secondary">No hay panels registrados.</h5>
                <p class="card-text text-muted mb-4">Comienza registrando el primer panel solar al sistema.</p>
                <AuthorizeView Roles="@AppRoles.Administrator">
                    <a href="/paneles/nuevo" class="btn btn-outline-primary">
                        <span class="bi bi-plus-circle me-1"></span> Registrar Panel
                    </a>
                </AuthorizeView>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">Número de serie</th>
                            <th scope="col">Potencia (W)</th>
                            <th scope="col">Eficiencia (%)</th>
                            <th scope="col">Parque solar</th>
                            <th scope="col" class="text-center">Estado</th>
                            <th scope="col" class="pe-3 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var panel in _panels)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">@panel.SerieNumber</td>
                                <td>@($"{panel.PowerW} W")</td>
                                <td>@($"{panel.Efficiency:0.##}%")</td>
                                <td>@panel.SolarParkName</td>
                                <td class="text-center">
                                    @if (panel.Status == "Activo")
                                    {
                                        <span class="badge bg-success px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    <AuthorizeView Roles="@AppRoles.Administrator">
                                        <a href="/paneles/editar/@panel.Id" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center">
                                            <span class="bi bi-pencil me-1"></span> Editar
                                        </a>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? Mensaje { get; set; }

    private IReadOnlyList<SolarPanelDto>? _panels;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPanelsAsync();
    }

    private async Task LoadPanelsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _panels = await ApiClient.GetAllAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo cargar el listado de panels. Intentá nuevamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
