@page "/nodos"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Any)]
@using SolarUY.ApiService.Services
@using SolarUY.ApiService.Dtos
@inject SolarNodeApiClient NodeApiClient
@inject SolarParkApiClient ParkApiClient
@inject NavigationManager NavManager

<PageTitle>Listado de Nodos — SolarUY</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            @if (!string.IsNullOrEmpty(Mensaje))
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                    <span class="bi bi-check-circle-fill me-2"></span>
                    <div>@Mensaje</div>
                    <button type="button" class="btn-close" @onclick="() => Mensaje = null" aria-label="Cerrar"></button>
                </div>
            }
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="card-title h5 mb-0 d-flex align-items-center">
                        <span class="bi bi-node-meet me-2" aria-hidden="true"></span>
                        Listado de Nodos
                    </h3>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <select class="form-select" @bind="_selectedParkId">
                            <option value="">-- Todos los parques --</option>
                            @foreach (var park in _activeParks)
                            {
                                <option value="@park.Id">@park.Name</option>
                            }
                        </select>
                        <AuthorizeView Roles="@AppRoles.Administrator">
                            <button type="button" class="btn btn-outline-primary" @onclick="IrAAlta">
                                <span class="bi bi-plus me-1"></span> Nuevo nodo
                            </button>
                        </AuthorizeView>
                    </div>

                    @if (!string.IsNullOrEmpty(_successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <span>@_successMessage</span>
                            <button type="button" class="btn-close" @onclick="() => _successMessage = null" aria-label="Cerrar"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_actionErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <span>@_actionErrorMessage</span>
                            <button type="button" class="btn-close" @onclick="() => _actionErrorMessage = null" aria-label="Cerrar"></button>
                        </div>
                    }

                    @if (_isLoading)
                    {
                        <div class="d-flex justify-content-center align-items-center py-5">
                            <div class="spinner-border text-primary me-2" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <span class="text-muted">Cargando listado de nodos...</span>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                            <span class="bi bi-exclamation-triangle-fill me-2"></span>
                            <span>@_errorMessage</span>
                            <button type="button" class="btn-close" @onclick="() => _errorMessage = null" aria-label="Cerrar"></button>
                        </div>
                    }
                    else if (_nodes == null || _nodes.Count == 0)
                    {
                        <div class="card border-0 shadow-sm text-center py-5">
                            <div class="card-body">
                                <div class="mb-3 text-muted">
                                    <span class="bi bi-inbox fs-1" aria-hidden="true"></span>
                                </div>
                                <h5 class="card-title text-secondary">No hay nodos registrados.</h5>
                                <p class="card-text text-muted mb-4">Comienza registrando un nodo solar al sistema.</p>
                                <AuthorizeView Roles="@AppRoles.Administrator">
                                    <a href="/nodos/nuevo" class="btn btn-outline-primary">
                                        <span class="bi bi-plus-circle me-1"></span> Registrar Nodo
                                    </a>
                                </AuthorizeView>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card border-0 shadow-sm">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col" class="ps-3">Nombre</th>
                                            <th scope="col">Parque solar</th>
                                            <th scope="col">Inversor</th>
                                            <th scope="col">Paneles asociados</th>
                                            <th scope="col">Estado</th>
                                            <th scope="col" class="pe-3 text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var node in _nodes)
                                        {
                                            <tr>
                                                <td class="ps-3">@node.Name</td>
                                                <td>@node.SolarParkName</td>
                                                <td>@(string.IsNullOrEmpty(node.InverterSerie) ? "Sin inversor asignado" : node.InverterSerie)</td>
                                                <td>@node.PanelsCount paneles</td>
                                                <td>
                                                    <span class="badge bg-@(node.Status == "Activo" ? "success" : "danger") fs-sm">
                                                        @node.Status
                                                    </span>
                                                </td>
                                                <td class="pe-3 text-end text-nowrap">
                                                    <AuthorizeView Roles="@AppRoles.Administrator">
                                                        <a href="/nodos/@node.Id/editar" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center">
                                                            <span class="bi bi-pencil me-1"></span> Editar
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary ms-1"
                                                                @onclick="() => OpenInverterModal(node)"
                                                                disabled="@(node.Status != "Activo")"
                                                                title="@(node.Status != "Activo" ? "No se puede asignar un inversor a un nodo inactivo." : null)">
                                                            @(string.IsNullOrEmpty(node.InverterSerie) ? "Asignar inversor" : "Cambiar inversor")
                                                        </button>
                                                        @if (!string.IsNullOrEmpty(node.InverterSerie))
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-danger ms-1" @onclick="() => RequestUnassign(node)">
                                                                Desvincular
                                                            </button>
                                                        }
                                                        <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => OpenPanelsModal(node)">
                                                            Paneles
                                                        </button>
                                                        @if (node.Status == "Activo")
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-warning ms-1" @onclick="() => OpenDeactivateModal(node)">
                                                                Dar de baja
                                                            </button>
                                                        }
                                                    </AuthorizeView>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (_nodeForInverter != null)
{
    <SolarNodeInverterModal Node="_nodeForInverter" OnClose="CloseInverterModal" OnSaved="OnInverterSaved" />
}

@if (_nodeForPanels != null)
{
    <SolarNodePanelsModal Node="_nodeForPanels" OnClose="ClosePanelsModal" OnChanged="OnPanelsChanged" />
}

@if (_nodeToUnassign != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, 0.5);" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">Desvincular inversor</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelUnassign" disabled="@_isUnassigning"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">¿Confirmás desvincular el inversor "@_nodeToUnassign.InverterSerie" del nodo "@_nodeToUnassign.Name"?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelUnassign" disabled="@_isUnassigning">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmUnassignAsync" disabled="@_isUnassigning">
                        @if (_isUnassigning)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>
    }

    @if (_nodeForDeactivate != null)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, 0.5);" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content shadow">
                    <div class="modal-header">
                        <h5 class="modal-title">Dar de baja nodo</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseDeactivateModal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">¿Confirmás la baja del nodo "@_nodeForDeactivate.Name"?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseDeactivateModal">Cancelar</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDeactivateAsync" disabled="@_isDeactivating">
                            @if (_isDeactivating)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            Confirmar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

@code {
    [Parameter]
    public Guid? SelectedParkId { get; set; }

    private string? _successMessage;
    private string? _actionErrorMessage;
    private SolarUY.ApiService.Dtos.SolarNodeDto? _nodeForInverter;
    private SolarUY.ApiService.Dtos.SolarNodeDto? _nodeForPanels;
    private SolarUY.ApiService.Dtos.SolarNodeDto? _nodeForDeactivate;
    private bool _isDeactivating;
    private SolarUY.ApiService.Dtos.SolarNodeDto? _nodeToUnassign;
    private bool _isUnassigning;

    private void OpenInverterModal(SolarUY.ApiService.Dtos.SolarNodeDto node)
    {
        _successMessage = null;
        _actionErrorMessage = null;
        _nodeForInverter = node;
    }

    private void CloseInverterModal()
    {
        _nodeForInverter = null;
    }

    private void OpenPanelsModal(SolarUY.ApiService.Dtos.SolarNodeDto node)
    {
        _successMessage = null;
        _actionErrorMessage = null;
        _nodeForPanels = node;
    }

    private void ClosePanelsModal()
    {
        _nodeForPanels = null;
    }

    private void OpenDeactivateModal(SolarUY.ApiService.Dtos.SolarNodeDto node)
    {
        _successMessage = null;
        _actionErrorMessage = null;
        _nodeForDeactivate = node;
    }

    private void CloseDeactivateModal()
    {
        _nodeForDeactivate = null;
    }

    private async Task ConfirmDeactivateAsync()
    {
        if (_nodeForDeactivate == null || _isDeactivating)
        {
            return;
        }

        _isDeactivating = true;

        try
        {
            var result = await NodeApiClient.DeactivateAsync(_nodeForDeactivate.Id);
            if (result.Success)
            {
                _successMessage = "Nodo dado de baja correctamente.";
            }
            else
            {
                _actionErrorMessage = result.ErrorMessage;
            }

            _nodeForDeactivate = null;
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            _actionErrorMessage = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            _isDeactivating = false;
        }
    }

    // Reload the list so the panel counter reflects the change.
    private async Task OnPanelsChanged(string message)
    {
        _nodeForPanels = null;
        _successMessage = message;
        await CargarDatosAsync();
    }

    private async Task OnInverterSaved(string message)
    {
        _nodeForInverter = null;
        _successMessage = message;
        await CargarDatosAsync();
    }

    private void RequestUnassign(SolarUY.ApiService.Dtos.SolarNodeDto node)
    {
        _successMessage = null;
        _actionErrorMessage = null;
        _nodeToUnassign = node;
    }

    private void CancelUnassign()
    {
        _nodeToUnassign = null;
    }

    private async Task ConfirmUnassignAsync()
    {
        if (_nodeToUnassign == null || _isUnassigning)
        {
            return;
        }

        _isUnassigning = true;

        try
        {
            var result = await NodeApiClient.UnassignInverterAsync(_nodeToUnassign.Id);
            if (result.Success)
            {
                _successMessage = "Inversor desvinculado correctamente del nodo.";
            }
            else
            {
                _actionErrorMessage = result.ErrorMessage;
            }

            _nodeToUnassign = null;
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            _actionErrorMessage = $"Error inesperado: {ex.Message}";
            _nodeToUnassign = null;
        }
        finally
        {
            _isUnassigning = false;
        }
    }

    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? Mensaje { get; set; }

    private List<SolarUY.ApiService.Dtos.SolarNodeDto> _nodes = new();
    private Guid? _selectedParkId;
    private List<SolarUY.Web.Services.SolarParkDto> _activeParks = new();
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await NodeApiClient.GetAllAsync(_selectedParkId);

            if (result.Success && result.Value != null)
            {
                _nodes = result.Value.ToList();
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Error desconocido al cargar los nodos.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }

        await CargarParquesAsync();
    }

    private async Task CargarParquesAsync()
    {
        try
        {
            _activeParks = (await ParkApiClient.GetAllAsync()).Where(p => p.Status == "Activo").ToList();
        }
        catch
        {
            // Ignorar errores al cargar parques, el listado de nodos aún se mostrará
        }
    }

    private void IrAAlta()
    {
        NavManager.NavigateTo("/nodos/nuevo", forceLoad: true);
    }
}