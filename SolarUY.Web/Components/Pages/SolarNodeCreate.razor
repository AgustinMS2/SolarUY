@page "/nodos/nuevo"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Administrator)]
@using SolarUY.ApiService.Services
@using SolarUY.Web.Services
@inject SolarNodeApiClient NodeApiClient
@inject SolarParkApiClient ParkApiClient
@inject NavigationManager NavManager

@using CreateSolarNodeRequest = SolarUY.ApiService.Dtos.CreateSolarNodeRequest;

<PageTitle>Alta de Nodo — SolarUY</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="card-title h5 mb-0 d-flex align-items-center">
                        <span class="bi bi-node-meet me-2" aria-hidden="true"></span>
                        Alta de Nodo
                    </h3>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(_successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                            <span class="bi bi-check-circle-fill me-2"></span>
                            <div>@_successMessage</div>
                            <button type="button" class="btn-close" @onclick="() => _successMessage = null" aria-label="Cerrar"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                            <span class="bi bi-exclamation-triangle-fill me-2"></span>
                            <div>@_errorMessage</div>
                            <button type="button" class="btn-close" @onclick="() => _errorMessage = null" aria-label="Cerrar"></button>
                        </div>
                    }

                    <EditForm Model="_formModel" OnValidSubmit="HandleSubmitAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="nodeName" class="form-label fw-semibold">Nombre del Nodo <span class="text-danger">*</span></label>
                            <InputText id="nodeName" class="form-control" placeholder="Ej: Nodo Principal" @bind-Value="_formModel.Name" />
                            <ValidationMessage For="@(() => _formModel.Name)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-3">
                            <label for="solarPark" class="form-label fw-semibold">Parque Solar <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="_formModel.SelectedParkId">
                                <option value="">-- Seleccionar parque --</option>
                                @foreach (var park in _activeParks)
                                {
                                    <option value="@park.Id">@park.Name</option>
                                }
                            </select>
                            <ValidationMessage For="@(() => _formModel.SelectedParkId)" class="text-danger small mt-1" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-primary px-4 d-flex align-items-center" disabled="@_isSubmitting">
                                @if (_isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span class="bi bi-save me-1" aria-hidden="true"></span>
                                    <span>Registrar Nodo</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private SolarNodeFormModel _formModel = new();
    private bool _isSubmitting;
    private string? _successMessage;
    private string? _errorMessage;
    private IReadOnlyList<SolarParkDto> _activeParks = new List<SolarParkDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadActiveParksAsync();
    }

    private async Task LoadActiveParksAsync()
    {
        _activeParks = await ParkApiClient.GetAllAsync();
    }

    private async Task HandleSubmitAsync()
    {
        _successMessage = null;
        _errorMessage = null;

        if (_formModel.SelectedParkId == Guid.Empty)
        {
            _errorMessage = "El parque solar es obligatorio.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var dto = new CreateSolarNodeRequest(_formModel.Name, _formModel.SelectedParkId);

            var result = await NodeApiClient.CreateAsync(dto);

            if (result.Success)
            {
                _successMessage = "Nodo creado correctamente.";
                _formModel = new SolarNodeFormModel(); // Limpiar formulario (RF-3)
                NavManager.NavigateTo("/nodos/nuevo", forceLoad: true);
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class SolarNodeFormModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede superar los 100 caracteres.")]
        public string Name { get; set; } = string.Empty;

        public Guid SelectedParkId { get; set; } = Guid.Empty;
    }
}