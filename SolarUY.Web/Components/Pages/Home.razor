@page "/"
@using SolarUY.Web.Security

<PageTitle>Inicio — SolarUY</PageTitle>

<div class="container-fluid px-0">
    @if (Sesion == "finalizada")
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill fs-5 me-2" aria-hidden="true"></i>
            <div>La sesión ha finalizado.</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Hero / Bienvenida -->
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: #FFFFFF;">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-12 col-lg-8">
                    <span class="badge bg-warning text-dark px-3 py-1 mb-2 fw-semibold" style="letter-spacing: 0.05em;">
                        <i class="bi bi-sun-fill me-1" aria-hidden="true"></i> ENERGÍA SOLAR FOTOVOLTAICA
                    </span>
                    <AuthorizeView>
                        <Authorized>
                            <h1 class="display-6 fw-bold text-white mb-2">
                                ¡Hola, @context.User.Identity?.Name!
                            </h1>
                            <p class="lead text-light opacity-75 mb-3" style="max-width: 600px;">
                                Bienvenido al centro de control y mantenimiento de SolarUY. Selecciona una acción para comenzar.
                            </p>
                        </Authorized>
                        <NotAuthorized>
                            <h1 class="display-6 fw-bold text-white mb-2">
                                Bienvenido a SolarUY
                            </h1>
                            <p class="lead text-light opacity-75 mb-3" style="max-width: 600px;">
                                Plataforma integral para el monitoreo, gestión y mantenimiento de parques fotovoltaicos, nodos e inversores.
                            </p>
                            <a href="account/login" data-enhance-nav="false" class="btn btn-warning btn-lg text-dark fw-bold px-4 shadow">
                                <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i> Iniciar sesión con Keycloak
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
                <div class="col-12 col-lg-4 text-center text-lg-end d-none d-lg-block">
                    <i class="bi bi-grid-1x2-fill" style="font-size: 6rem; opacity: 0.15;" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Secciones según rol -->
    <AuthorizeView Roles="@AppRoles.Technician">
        <div class="mb-4">
            <h2 class="h5 fw-bold text-dark mb-3 d-flex align-items-center">
                <i class="bi bi-tools text-primary me-2" aria-hidden="true"></i> Panel de Trabajo de Campo
            </h2>
            <div class="row g-3">
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 border-start border-warning border-4 shadow-sm hover-shadow">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-warning text-dark">Prioritario</span>
                                <i class="bi bi-phone fs-4 text-muted" aria-hidden="true"></i>
                            </div>
                            <h3 class="h5 fw-bold text-dark mb-1">Mis Mantenimientos</h3>
                            <p class="text-muted small flex-grow-1">
                                Vista optimizada para móvil con tus tareas asignadas para hoy, ubicación de parques, nodos y botón directo de confirmación.
                            </p>
                            <a href="mis-mantenimientos" class="btn btn-warning text-dark fw-bold w-100">
                                <i class="bi bi-arrow-right-circle me-1" aria-hidden="true"></i> Abrir Mis Tareas
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm hover-shadow">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-info text-dark">Consulta</span>
                                <i class="bi bi-sun fs-4 text-muted" aria-hidden="true"></i>
                            </div>
                            <h3 class="h5 fw-bold text-dark mb-1">Parques e Infraestructura</h3>
                            <p class="text-muted small flex-grow-1">
                                Consulta la ubicación geográfica, capacidad en kW y paneles instalados en cada parque solar.
                            </p>
                            <a href="parques" class="btn btn-outline-primary w-100">
                                Ver Parques Solares
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm hover-shadow">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-secondary">Calendario</span>
                                <i class="bi bi-calendar3 fs-4 text-muted" aria-hidden="true"></i>
                            </div>
                            <h3 class="h5 fw-bold text-dark mb-1">Mantenimientos Generales</h3>
                            <p class="text-muted small flex-grow-1">
                                Explora el listado general con filtros de fechas, estados e historial de intervenciones.
                            </p>
                            <a href="mantenimientos" class="btn btn-outline-primary w-100">
                                Ver Calendario Completo
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.Administrator">
        <div class="mb-4">
            <h2 class="h5 fw-bold text-dark mb-3 d-flex align-items-center">
                <i class="bi bi-speedometer2 text-primary me-2" aria-hidden="true"></i> Operaciones y Administración
            </h2>
            <div class="row g-3">
                <!-- Mantenimiento -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body p-3 p-md-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-2">
                                <span class="p-2 bg-primary bg-opacity-10 text-primary rounded-3 me-2">
                                    <i class="bi bi-calendar-check-fill fs-5" aria-hidden="true"></i>
                                </span>
                                <h3 class="h6 fw-bold mb-0">Mantenimiento</h3>
                            </div>
                            <p class="text-muted small flex-grow-1">
                                Reserva de fechas para preventivo/correctivo, asignación de técnicos y filtros combinables.
                            </p>
                            <div class="d-flex gap-2">
                                <a href="mantenimientos/nuevo" class="btn btn-sm btn-primary flex-fill">
                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Reservar
                                </a>
                                <a href="mantenimientos" class="btn btn-sm btn-outline-secondary flex-fill">
                                    Ver todos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Parques -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body p-3 p-md-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-2">
                                <span class="p-2 bg-warning bg-opacity-10 text-warning rounded-3 me-2">
                                    <i class="bi bi-sun-fill fs-5 text-warning" aria-hidden="true"></i>
                                </span>
                                <h3 class="h6 fw-bold mb-0">Parques Solares</h3>
                            </div>
                            <p class="text-muted small flex-grow-1">
                                Alta, edición y monitoreo de parques, capacidad instalada y umbrales de alerta.
                            </p>
                            <div class="d-flex gap-2">
                                <a href="parques/nuevo" class="btn btn-sm btn-primary flex-fill">
                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nuevo Parque
                                </a>
                                <a href="parques" class="btn btn-sm btn-outline-secondary flex-fill">
                                    Listar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nodos e Inversores -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body p-3 p-md-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-2">
                                <span class="p-2 bg-info bg-opacity-10 text-info rounded-3 me-2">
                                    <i class="bi bi-diagram-3-fill fs-5 text-info" aria-hidden="true"></i>
                                </span>
                                <h3 class="h6 fw-bold mb-0">Nodos e Inversores</h3>
                            </div>
                            <p class="text-muted small flex-grow-1">
                                Puntos de conexión del parque, asignación y desvinculación de inversores y strings.
                            </p>
                            <div class="d-flex gap-2">
                                <a href="nodos" class="btn btn-sm btn-outline-primary flex-fill">
                                    Gestionar Nodos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Paneles -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body p-3 p-md-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-2">
                                <span class="p-2 bg-success bg-opacity-10 text-success rounded-3 me-2">
                                    <i class="bi bi-grid-3x3 fs-5 text-success" aria-hidden="true"></i>
                                </span>
                                <h3 class="h6 fw-bold mb-0">Paneles Fotovoltaicos</h3>
                            </div>
                            <p class="text-muted small flex-grow-1">
                                Inventario por número de serie, potencia (W), eficiencia (%) y asignación a nodos.
                            </p>
                            <div class="d-flex gap-2">
                                <a href="paneles/nuevo" class="btn btn-sm btn-primary flex-fill">
                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nuevo Panel
                                </a>
                                <a href="paneles" class="btn btn-sm btn-outline-secondary flex-fill">
                                    Listar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Técnicos -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body p-3 p-md-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-2">
                                <span class="p-2 bg-secondary bg-opacity-10 text-secondary rounded-3 me-2">
                                    <i class="bi bi-person-badge-fill fs-5" aria-hidden="true"></i>
                                </span>
                                <h3 class="h6 fw-bold mb-0">Personal Técnico</h3>
                            </div>
                            <p class="text-muted small flex-grow-1">
                                Registro de técnicos habilitados, especialidades, contacto y estado operativo.
                            </p>
                            <div class="d-flex gap-2">
                                <a href="tecnicos" class="btn btn-sm btn-outline-primary flex-fill">
                                    Listado de Técnicos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Usuarios y Roles -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body p-3 p-md-4 d-flex flex-column">
                            <div class="d-flex align-items-center mb-2">
                                <span class="p-2 bg-primary bg-opacity-10 text-primary rounded-3 me-2">
                                    <i class="bi bi-shield-lock-fill fs-5 text-primary" aria-hidden="true"></i>
                                </span>
                                <h3 class="h6 fw-bold mb-0">Usuarios & Roles</h3>
                            </div>
                            <p class="text-muted small flex-grow-1">
                                Administración de cuentas de Keycloak, cambio de roles (Administrador / Técnico).
                            </p>
                            <div class="d-flex gap-2">
                                <a href="usuarios" class="btn btn-sm btn-outline-primary flex-fill">
                                    Gestionar Roles
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </AuthorizeView>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sesion")]
    public string? Sesion { get; set; }
}
