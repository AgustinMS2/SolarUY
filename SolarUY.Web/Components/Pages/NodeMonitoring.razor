@page "/nodos/{id:guid}/monitoreo"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Any)]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using SolarUY.ApiService.Dtos
@using SolarUY.ApiService.Services
@using SolarUY.Web.Security
@inject SolarNodeApiClient NodeApiClient
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IHttpMessageHandlerFactory HttpMessageHandlerFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject KeycloakTokenService TokenService
@inject ILogger<NodeMonitoring> Logger

<PageTitle>Monitoreo en Tiempo Real — @(_node?.Name ?? "Nodo Solar") — SolarUY</PageTitle>

<div class="container py-4">
    <!-- Breadcrumb & Navigation -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/nodos" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center">
                    <span class="bi bi-arrow-left me-1"></span> Volver a Nodos
                </a>
                <span class="text-muted">/</span>
                <span class="text-secondary small fw-medium">Monitoreo en Vivo</span>
            </div>
            <h1 class="h3 mb-0 text-primary d-flex align-items-center">
                <span class="bi bi-cpu me-2" aria-hidden="true"></span>
                @(_node?.Name ?? "Cargando nodo...")
                @if (_node != null)
                {
                    <span class="badge bg-light text-secondary border ms-2 fs-6 fw-normal">@_node.SolarParkName</span>
                }
            </h1>
        </div>

        <!-- Connection Status Indicator (RF-1 / RF-6) -->
        <div class="d-flex align-items-center gap-2">
            @if (NodeHasNoInverter)
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center fs-6">
                    <span class="bi bi-pause-circle me-1" aria-hidden="true"></span>
                    <span>Sin telemetría</span>
                </span>
            }
            else if (_hubConnection?.State == HubConnectionState.Connected)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center fs-6">
                    <span class="spinner-grow spinner-grow-sm me-2 text-success" role="status" aria-hidden="true"></span>
                    <span>Conectado en vivo</span>
                </span>
            }
            else if (_hubConnection?.State == HubConnectionState.Reconnecting)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center fs-6">
                    <span class="spinner-border spinner-border-sm me-2 text-warning" role="status" aria-hidden="true"></span>
                    <span>Reconectando con el inversor...</span>
                </span>
            }
            else
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center fs-6">
                    <span class="bi bi-x-circle me-1" aria-hidden="true"></span>
                    <span>Desconectado</span>
                </span>
            }
        </div>
    </div>

    @if (_isLoadingNode)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary me-2" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <span class="text-muted">Cargando información del nodo...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <span class="bi bi-exclamation-triangle-fill me-2 fs-5"></span>
                <div>@_errorMessage</div>
            </div>
            <a href="/nodos" class="btn btn-outline-danger btn-sm">Volver al listado</a>
        </div>
    }
    else if (_node != null)
    {
        @if (NodeHasNoInverter)
        {
            <!-- RF-5: Nodo sin inversor asignado -->
            <div class="alert alert-secondary d-flex align-items-center mb-4 border-0 shadow-sm" role="alert">
                <span class="bi bi-info-circle-fill fs-4 text-secondary me-3"></span>
                <div>
                    <h6 class="alert-heading fw-bold mb-0">Este nodo no posee un inversor configurado.</h6>
                    <p class="mb-0 text-muted small">Asigná un inversor desde el listado de nodos para habilitar la telemetría en tiempo real.</p>
                </div>
            </div>
        }

        @if (_node.Status != "Activo")
        {
            <!-- Caso límite: Nodo inactivo -->
            <div class="alert alert-secondary d-flex align-items-center mb-4 border-0 shadow-sm" role="alert">
                <span class="bi bi-pause-circle-fill fs-4 text-secondary me-3"></span>
                <div>
                    <h6 class="alert-heading fw-bold mb-0">Nodo no activo</h6>
                    <p class="mb-0 text-muted small">El nodo se encuentra inactivo operativamente. Las lecturas eléctricas permanecerán en cero.</p>
                </div>
            </div>
        }

        <!-- RF-3 Alert: Sobretemperatura en inversor -->
        @if (_telemetry?.IsOverheating == true)
        {
            <div class="alert alert-warning border-warning-subtle d-flex align-items-center mb-4 shadow-sm" role="alert">
                <span class="bi bi-thermometer-sun fs-3 text-danger me-3"></span>
                <div>
                    <h6 class="alert-heading fw-bold mb-1">Sobretemperatura en inversor (@($"{_telemetry.InverterTemperatureC:0.0} °C"))</h6>
                    <p class="mb-0 small">
                        La temperatura interna del inversor superó el umbral operativo de 75 °C. Revisá la ventilación y la carga del equipo.
                    </p>
                </div>
            </div>
        }

        <!-- RF-4 Alert: Anomalía en sincronismo de red -->
        @if (_telemetry?.IsGridFrequencyAnomaly == true)
        {
            <div class="alert alert-danger border-danger-subtle d-flex align-items-center mb-4 shadow-sm" role="alert">
                <span class="bi bi-lightning fs-3 text-danger me-3"></span>
                <div>
                    <h6 class="alert-heading fw-bold mb-1">Anomalía en sincronismo de red eléctrica (@($"{_telemetry.GridFrequencyHz:0.00} Hz"))</h6>
                    <p class="mb-0 small">
                        La frecuencia de red se desvió del rango operativo de 50 ± 0.5 Hz. Verificá el estado de la conexión a la red eléctrica.
                    </p>
                </div>
            </div>
        }

        <!-- RF-6 Warning: Reconectando SignalR -->
        @if (_hubConnection?.State == HubConnectionState.Reconnecting)
        {
            <div class="alert alert-info border-info-subtle d-flex align-items-center mb-4 shadow-sm" role="alert">
                <span class="spinner-border spinner-border-sm text-info me-2" role="status"></span>
                <div>
                    Reconectando con el inversor... Se mantiene visible la última lectura recibida (@(_telemetry?.TimestampUtc.ToLocalTime().ToString("HH:mm:ss") ?? "reciente")).
                </div>
            </div>
        }

        <!-- Main Monitoring Dashboard Grid -->
        <div class="row g-4 mb-4">
            <!-- Left Column: Mini-Gráfica SVG Reactiva (RF-2) -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100 rounded-3">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                        <h2 class="h5 mb-0 text-secondary fw-bold d-flex align-items-center">
                            <span class="bi bi-graph-up me-2 text-primary"></span> Tendencia de Potencia Activa
                        </h2>
                        <span class="badge bg-light text-muted border">Actualización 3s</span>
                    </div>
                    <div class="card-body d-flex flex-column justify-content-center px-4 py-3">
                        <div class="position-relative w-100 text-center">
                            <svg viewBox="0 0 300 100" class="w-100 h-auto" style="overflow: visible;">
                                <defs>
                                    <linearGradient id="sparkAreaGradient" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#0284c7" stop-opacity="0.35" />
                                        <stop offset="100%" stop-color="#0284c7" stop-opacity="0.02" />
                                    </linearGradient>
                                </defs>

                                @if (_powerHistory.Count == 0)
                                {
                                    <line x1="0" y1="94" x2="300" y2="94" stroke="#e2e8f0" stroke-width="2" stroke-dasharray="4 4" />
                                }
                                else
                                {
                                    <!-- Área bajo la curva -->
                                    <polygon points="@SparkAreaPoints" fill="url(#sparkAreaGradient)" />
                                    <!-- Línea de tendencia -->
                                    <polyline points="@SparklinePoints"
                                              fill="none"
                                              stroke="@SparkStrokeColor"
                                              stroke-width="2.5"
                                              stroke-linecap="round"
                                              stroke-linejoin="round"
                                              style="transition: all 0.4s ease-out;" />
                                    <!-- Último punto destacado -->
                                    <circle cx="@LastPointX" cy="@LastPointY" r="4"
                                            fill="@SparkStrokeColor"
                                            stroke="#ffffff"
                                            stroke-width="2" />
                                }
                            </svg>

                            <div class="mt-2">
                                @if (_powerHistory.Count == 0)
                                {
                                    <small class="text-muted d-block mb-1">Aguardando lecturas del inversor...</small>
                                }
                                <div class="display-6 fw-bold text-dark">
                                    @ActivePowerKw.ToString("F1") <span class="fs-4 fw-normal text-muted">kW</span>
                                </div>
                                <div class="badge bg-primary-subtle text-primary px-3 py-1 fs-6 rounded-pill mt-1">
                                    @($"{CapacityPercentage:0.0}% de {NominalCapacityDisplay} kW nominales")
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 px-4 text-center">
                        <small class="text-muted">
                            Última lectura: @(_telemetry != null ? _telemetry.TimestampUtc.ToLocalTime().ToString("HH:mm:ss") : "Aguardando emisión...")
                        </small>
                    </div>
                </div>
            </div>

            <!-- Right Column: 6 Electric Metric Cards (RF-2) -->
            <div class="col-12 col-lg-6">
                <div class="row g-3 h-100">
                    <!-- 1. Potencia Activa -->
                    <div class="col-12 col-sm-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-secondary fw-semibold small text-uppercase">Potencia Activa</span>
                                    <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                                        <span class="bi bi-lightning-charge-fill fs-6"></span>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-0 text-dark">@($"{ActivePowerKw:0.0} kW")</h4>
                                    <small class="text-muted">@($"{CapacityPercentage:0.0}% nominal")</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Voltaje DC de Entrada -->
                    <div class="col-12 col-sm-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-secondary fw-semibold small text-uppercase">Voltaje DC</span>
                                    <div class="p-2 rounded-3 bg-info-subtle text-info">
                                        <span class="bi bi-plug-fill fs-6"></span>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-0 text-dark">@($"{DcVoltage:0} V")</h4>
                                    <small class="text-muted">Entrada 200 – 1000 V</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Corriente DC -->
                    <div class="col-12 col-sm-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-secondary fw-semibold small text-uppercase">Corriente DC</span>
                                    <div class="p-2 rounded-3 bg-success-subtle text-success">
                                        <span class="bi bi-arrow-down-up fs-6"></span>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-0 text-dark">@($"{DcCurrent:0.0} A")</h4>
                                    <small class="text-muted">Suministro al inversor</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Voltaje AC de Salida -->
                    <div class="col-12 col-sm-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-secondary fw-semibold small text-uppercase">Voltaje AC</span>
                                    <div class="p-2 rounded-3 bg-secondary-subtle text-secondary">
                                        <span class="bi bi-outlet fs-6"></span>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-0 text-dark">@($"{AcVoltage:0.0} V")</h4>
                                    <small class="text-muted">Red trifásica 380 V</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 5. Frecuencia de Red (RF-4) -->
                    <div class="col-12 col-sm-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100 @(_telemetry?.IsGridFrequencyAnomaly == true ? "border-danger" : "")">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-secondary fw-semibold small text-uppercase">Frecuencia Red</span>
                                    <div class="p-2 rounded-3 @(_telemetry?.IsGridFrequencyAnomaly == true ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning")">
                                        <span class="bi bi-speedometer fs-6"></span>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-0 @(_telemetry?.IsGridFrequencyAnomaly == true ? "text-danger" : "text-dark")">
                                        @($"{GridFrequencyHz:0.00} Hz")
                                    </h4>
                                    <small class="@(_telemetry?.IsGridFrequencyAnomaly == true ? "text-danger fw-semibold" : "text-muted")">Nominal 50 ± 0.5 Hz</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 6. Temperatura Interna (RF-3) -->
                    <div class="col-12 col-sm-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100 @(_telemetry?.IsOverheating == true ? "border-warning" : "")">
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-secondary fw-semibold small text-uppercase">Temperatura</span>
                                    <div class="p-2 rounded-3 @(_telemetry?.IsOverheating == true ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")">
                                        <span class="bi bi-thermometer-half fs-6"></span>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-0 @(_telemetry?.IsOverheating == true ? "text-danger" : "text-dark")">
                                        @($"{InverterTemperatureC:0.0} °C")
                                    </h4>
                                    <small class="@(_telemetry?.IsOverheating == true ? "text-danger fw-semibold" : "text-muted")">Umbral 75 °C</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Node Details Summary Strip -->
        <div class="card border-0 shadow-sm rounded-3 bg-light">
            <div class="card-body px-4 py-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="bi bi-cpu-fill text-primary"></span>
                    <span class="text-secondary small">Inversor: <strong class="font-monospace">@(_node.InverterSerie ?? "Sin asignar")</strong></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="bi bi-broadcast text-primary"></span>
                    <span class="text-secondary small">Canal SignalR: <strong>node-@Id</strong></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="bi bi-check-circle-fill @(NodeHasNoInverter ? "text-secondary" : "text-success")"></span>
                    <span class="text-secondary small">Estado del Nodo: <strong>@_node.Status</strong></span>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private const int PowerHistoryCapacity = 20;

    private SolarNodeDto? _node;
    private NodeTelemetryDto? _telemetry;
    private HubConnection? _hubConnection;
    private readonly List<double> _powerHistory = new();
    private bool _isLoadingNode = true;
    private string? _errorMessage;

    private bool NodeHasNoInverter => string.IsNullOrEmpty(_node?.InverterSerie);

    private double ActivePowerKw => _telemetry?.ActivePowerKw ?? 0.0;
    private double DcVoltage => _telemetry?.DcVoltage ?? 0.0;
    private double DcCurrent => _telemetry?.DcCurrent ?? 0.0;
    private double AcVoltage => _telemetry?.AcVoltage ?? 0.0;
    private double GridFrequencyHz => _telemetry?.GridFrequencyHz ?? 0.0;
    private double InverterTemperatureC => _telemetry?.InverterTemperatureC ?? 0.0;

    private double CapacityPercentage
    {
        get
        {
            var nominal = _telemetry?.NominalCapacityKw ?? 0.0;
            return nominal > 0.0 ? Math.Clamp((ActivePowerKw / nominal) * 100.0, 0.0, 100.0) : 0.0;
        }
    }

    private string NominalCapacityDisplay => (_telemetry?.NominalCapacityKw ?? 0.0).ToString("0.##");

    private string SparklinePoints => BuildSparkPoints(includeArea: false);

    private string SparkAreaPoints => BuildSparkPoints(includeArea: true);

    private string SparkStrokeColor =>
        _telemetry?.IsGridFrequencyAnomaly == true || _telemetry?.IsOverheating == true
            ? "#dc2626" // rojo
            : "#0284c7"; // azul océano

    private string LastPointX => (_powerHistory.Count > 1 ? 300.0 : 0.0).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private string LastPointY => MapPowerToY(_powerHistory.Count > 0 ? _powerHistory[^1] : 0.0).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        await LoadNodeAndConnectSignalRAsync();
    }

    private async Task LoadNodeAndConnectSignalRAsync()
    {
        _isLoadingNode = true;
        _errorMessage = null;

        try
        {
            var result = await NodeApiClient.GetByIdAsync(Id);
            if (!result.Success || result.Value == null)
            {
                _errorMessage = "No se encontró el nodo solar solicitado.";
                _isLoadingNode = false;
                return;
            }

            _node = result.Value;
            _isLoadingNode = false;

            if (NodeHasNoInverter)
            {
                // RF-5: sin inversor asignado no se abre la conexión de telemetría en vivo.
                return;
            }

            await InitializeSignalRAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando nodo solar {NodeId}", Id);
            _errorMessage = $"Error al cargar los datos del nodo: {ex.Message}";
            _isLoadingNode = false;
        }
    }

    private async Task InitializeSignalRAsync()
    {
        try
        {
            var apiBaseUrl = Configuration["services:apiservice:https:0"]
                ?? Configuration["services:apiservice:http:0"]
                ?? "http://apiservice";
            var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/hubs/node-telemetry";

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.HttpMessageHandlerFactory = _ => HttpMessageHandlerFactory.CreateHandler();
                    options.AccessTokenProvider = async () =>
                    {
                        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                        var key = UserTokenStore.GetKey(authState.User);
                        if (key == null) return null;
                        return await TokenService.GetValidAccessTokenAsync(key, CancellationToken.None);
                    };
                })
                .WithAutomaticReconnect(new[] { TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10) })
                .Build();

            _hubConnection.On<NodeTelemetryDto>("ReceiveNodeTelemetry", (telemetry) =>
            {
                if (telemetry.NodeId == Id)
                {
                    _telemetry = telemetry;
                    _powerHistory.Add(telemetry.ActivePowerKw);
                    if (_powerHistory.Count > PowerHistoryCapacity)
                    {
                        _powerHistory.RemoveAt(0);
                    }
                    InvokeAsync(StateHasChanged);
                }
            });

            _hubConnection.Reconnecting += (error) =>
            {
                Logger.LogWarning(error, "SignalR reconectando para el nodo {NodeId}", Id);
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            _hubConnection.Reconnected += async (connectionId) =>
            {
                Logger.LogInformation("SignalR reconectado ({ConnectionId}). Re-suscribiendo a nodo {NodeId}", connectionId, Id);
                await _hubConnection.InvokeAsync("SubscribeToNode", Id);
                await InvokeAsync(StateHasChanged);
            };

            _hubConnection.Closed += (error) =>
            {
                Logger.LogWarning(error, "SignalR desconectado para el nodo {NodeId}", Id);
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("SubscribeToNode", Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error conectando al hub SignalR de telemetría para el nodo {NodeId}", Id);
        }
    }

    private string BuildSparkPoints(bool includeArea)
    {
        if (_powerHistory.Count == 0)
        {
            return string.Empty;
        }

        var maxReference = Math.Max(_telemetry?.NominalCapacityKw ?? 0.0, _powerHistory.Max());
        if (maxReference <= 0.0)
        {
            maxReference = 1.0;
        }

        const double width = 300.0;
        const double height = 100.0;
        var count = _powerHistory.Count;
        var step = count > 1 ? width / (count - 1) : width;

        var points = new List<string>(count);
        for (var i = 0; i < count; i++)
        {
            var x = count > 1 ? i * step : 0.0;
            var y = MapPowerToY(_powerHistory[i], maxReference);
            points.Add($"{Format(x)},{Format(y)}");
        }

        if (includeArea && count > 1)
        {
            points.Add($"{Format(width)},{Format(height)}");
            points.Add($"0,{Format(height)}");
        }

        return string.Join(" ", points);
    }

    private double MapPowerToY(double powerKw, double? maxReference = null)
    {
        const double height = 100.0;
        var reference = maxReference ?? Math.Max(_telemetry?.NominalCapacityKw ?? 0.0, _powerHistory.Count > 0 ? _powerHistory.Max() : 0.0);
        if (reference <= 0.0)
        {
            reference = 1.0;
        }

        var clamped = Math.Clamp(powerKw / reference, 0.0, 1.0);
        return height - 6.0 - (clamped * (height - 12.0));
    }

    private static string Format(double value) => value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            try
            {
                if (_hubConnection.State == HubConnectionState.Connected)
                {
                    // RF-7: desuscribirse del grupo del nodo al abandonar la pantalla.
                    await _hubConnection.InvokeAsync("UnsubscribeFromNode", Id);
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Error cerrando suscripción SignalR para nodo {NodeId}", Id);
            }
            finally
            {
                await _hubConnection.DisposeAsync();
            }
        }
    }
}
