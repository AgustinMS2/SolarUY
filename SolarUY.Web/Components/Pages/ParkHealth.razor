@page "/parques/{id:guid}/salud"
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Any)]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client
@using SolarUY.ApiService.Dtos
@using SolarUY.Web.Services
@using SolarUY.Web.Security
@inject SolarParkApiClient ParkApiClient
@inject IConfiguration Configuration
@inject IHttpMessageHandlerFactory HttpMessageHandlerFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject KeycloakTokenService TokenService
@inject ILogger<ParkHealth> Logger

<PageTitle>Mapa de Salud — @(_snapshot?.ParkName ?? "Parque Solar") — SolarUY</PageTitle>

<div class="container py-4">
    <!-- Navegación y estado del enlace -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/parques" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center">
                    <span class="bi bi-arrow-left me-1"></span> Volver a Parques
                </a>
                <span class="text-muted">/</span>
                <span class="text-secondary small fw-medium">Mapa de Salud</span>
            </div>
            <h1 class="h3 mb-0 text-primary d-flex align-items-center">
                <span class="bi bi-heart-pulse me-2" aria-hidden="true"></span>
                @(_snapshot?.ParkName ?? _park?.Name ?? "Cargando parque...")
            </h1>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (!_isLive)
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center fs-6">
                    <span class="bi bi-pause-circle me-1" aria-hidden="true"></span>
                    <span>Sin telemetría</span>
                </span>
            }
            else if (_hubConnection?.State == HubConnectionState.Connected)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center fs-6">
                    <span class="spinner-grow spinner-grow-sm me-2 text-success" role="status" aria-hidden="true"></span>
                    <span>Conectado en vivo</span>
                </span>
            }
            else if (_hubConnection?.State == HubConnectionState.Reconnecting)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center fs-6">
                    <span class="spinner-border spinner-border-sm me-2 text-warning" role="status" aria-hidden="true"></span>
                    <span>Reconectando con el parque...</span>
                </span>
            }
            else
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill d-inline-flex align-items-center fs-6">
                    <span class="bi bi-x-circle me-1" aria-hidden="true"></span>
                    <span>Desconectado</span>
                </span>
            }
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary me-2" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <span class="text-muted">Cargando el mapa de salud...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <span class="bi bi-exclamation-triangle-fill me-2 fs-5"></span>
                <div>@_errorMessage</div>
            </div>
            <a href="/parques" class="btn btn-outline-danger btn-sm">Volver al listado</a>
        </div>
    }
    else if (!string.IsNullOrEmpty(_infoMessage))
    {
        <div class="alert alert-secondary d-flex align-items-center mb-4 border-0 shadow-sm" role="alert">
            <span class="bi bi-info-circle-fill fs-4 text-secondary me-3"></span>
            <div>
                <h6 class="alert-heading fw-bold mb-0">@_infoMessage</h6>
            </div>
        </div>
    }
    else if (_snapshot != null)
    {
        <!-- RF-6: reconectando -->
        @if (_hubConnection?.State == HubConnectionState.Reconnecting)
        {
            <div class="alert alert-info border-info-subtle d-flex align-items-center mb-4 shadow-sm" role="alert">
                <span class="spinner-border spinner-border-sm text-info me-2" role="status"></span>
                <div>
                    Reconectando con el parque... Se mantiene visible el último estado recibido (@_lastUpdateUtc.ToLocalTime().ToString("HH:mm:ss")).
                </div>
            </div>
        }

        <!-- RF-4: contadores -->
        <div class="row g-3 mb-3">
            @foreach (var counter in Counters)
            {
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body p-3">
                            <div class="text-secondary fw-semibold small text-uppercase">
                                @if (counter.CssClass != null)
                                {
                                    <span class="legend-dot @counter.CssClass"></span>
                                }
                                @counter.Label
                            </div>
                            <div class="counter-value text-dark mt-1">@counter.Value</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Leyenda de colores (siempre visible) -->
        <div class="d-flex flex-wrap gap-3 small text-secondary mb-4" aria-label="Leyenda de colores">
            @foreach (var state in StateOrder)
            {
                <span><span class="legend-dot @StateCss(state)"></span>@StateLabel(state)</span>
            }
        </div>

        <div class="row g-4">
            <!-- RF-1, RF-2: cuadrícula agrupada por nodo -->
            <div class="col-12 col-xl-8">
                @foreach (var node in _snapshot.Nodes)
                {
                    <div class="card border-0 shadow-sm rounded-3 mb-3" @key="node.NodeId">
                        <div class="card-header bg-transparent border-0 pt-3 px-3 pb-0 d-flex justify-content-between align-items-center">
                            <h2 class="h6 mb-0 text-secondary fw-bold d-flex align-items-center">
                                <span class="bi bi-cpu me-2 text-primary"></span> @node.NodeName
                            </h2>
                            <span class="badge bg-light text-muted border">@node.Panels.Count paneles</span>
                        </div>
                        <div class="card-body p-3 d-flex flex-wrap gap-2">
                            @foreach (var panel in node.Panels)
                            {
                                <button type="button" @key="panel.PanelId"
                                        class="health-cell @StateCss(panel.Reading.State) @(_selectedPanelId == panel.PanelId ? "selected" : "")"
                                        title="@panel.SerieNumber — @StateLabel(panel.Reading.State)"
                                        aria-label="@($"{panel.SerieNumber}, {StateLabel(panel.Reading.State)}")"
                                        @onclick="() => SelectPanel(panel.PanelId)"
                                        @onmouseenter="() => SelectPanel(panel.PanelId)">
                                    @panel.SerieNumber
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- RF-3: tarjeta de detalle -->
            <div class="col-12 col-xl-4">
                @if (SelectedPanel is { } selected)
                {
                    <div class="card border-0 shadow-sm rounded-3 sticky-xl-top" style="top: 1rem;">
                        <div class="card-header bg-transparent border-0 pt-3 px-3 pb-0 d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-bold text-dark font-monospace">@selected.Panel.SerieNumber</div>
                                <small class="text-muted">Nodo: @selected.NodeName</small>
                            </div>
                            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _selectedPanelId = null"></button>
                        </div>
                        <div class="card-body px-3 pb-3">
                            <div class="mb-3">
                                <span class="legend-dot @StateCss(selected.Panel.Reading.State)"></span>
                                <span class="fw-semibold">@StateLabel(selected.Panel.Reading.State)</span>
                                @if (!string.IsNullOrEmpty(selected.Panel.Reading.StateReason))
                                {
                                    <div class="small text-muted mt-1">@selected.Panel.Reading.StateReason</div>
                                }
                                @if (selected.Panel.Reading.IsLowPerformance)
                                {
                                    <div class="small text-warning-emphasis mt-1">Rendimiento bajo / Posible sombreado o suciedad</div>
                                }
                            </div>
                            <dl class="row mb-3 small">
                                <dt class="col-6 text-secondary fw-normal">Potencia actual</dt>
                                <dd class="col-6 text-end fw-semibold">@FormatPower(selected.Panel.Reading.ActivePowerW)</dd>
                                <dt class="col-6 text-secondary fw-normal">Eficiencia actual</dt>
                                <dd class="col-6 text-end fw-semibold">@FormatEfficiency(selected.Panel.Reading)</dd>
                                <dt class="col-6 text-secondary fw-normal">Potencia de placa</dt>
                                <dd class="col-6 text-end">@($"{selected.Panel.NominalPowerW} W")</dd>
                                <dt class="col-6 text-secondary fw-normal">Último mantenimiento</dt>
                                <dd class="col-6 text-end">@FormatLastMaintenance(selected.Panel.LastMaintenanceUtc)</dd>
                            </dl>
                            <a href="/paneles/@selected.Panel.PanelId/monitoreo" class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center">
                                <span class="bi bi-activity me-1"></span> Ver detalle
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted small border rounded-3 p-3 bg-white">
                        Pasá el cursor o tocá un panel de la cuadrícula para ver su detalle.
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private sealed record CounterItem(string Label, int Value, string? CssClass);

    private sealed record SelectedInfo(ParkHealthPanelDto Panel, string NodeName);

    private static readonly PanelHealthState[] StateOrder =
        [PanelHealthState.Normal, PanelHealthState.Degraded, PanelHealthState.Critical, PanelHealthState.NoSun, PanelHealthState.Inactive];

    private static readonly string[] UruguayTimeZoneIds = ["America/Montevideo", "Montevideo Standard Time"];

    [Parameter]
    public Guid Id { get; set; }

    private SolarUY.Web.Services.SolarParkDto? _park;
    private ParkHealthSnapshotDto? _snapshot;
    private ParkHealthSummaryDto _summary = new();
    private Dictionary<Guid, ParkHealthPanelDto> _panelsById = new();
    private HubConnection? _hubConnection;
    private Guid? _selectedPanelId;
    private DateTime _lastUpdateUtc = DateTime.UtcNow;
    private bool _isLoading = true;
    private bool _isLive;
    private string? _errorMessage;
    private string? _infoMessage;

    private IEnumerable<CounterItem> Counters =>
    [
        new("Total", _summary.Total, null),
        new("Normal", _summary.Normal, StateCss(PanelHealthState.Normal)),
        new("Alerta", _summary.Degraded, StateCss(PanelHealthState.Degraded)),
        new("Falla", _summary.Critical, StateCss(PanelHealthState.Critical)),
        new("Sin sol", _summary.NoSun, StateCss(PanelHealthState.NoSun)),
        new("Inactivos", _summary.Inactive, StateCss(PanelHealthState.Inactive))
    ];

    private SelectedInfo? SelectedPanel
    {
        get
        {
            if (_selectedPanelId is not { } id || _snapshot is null || !_panelsById.TryGetValue(id, out var panel))
            {
                return null;
            }

            var node = _snapshot.Nodes.FirstOrDefault(n => n.Panels.Any(p => p.PanelId == id));
            return new SelectedInfo(panel, node?.NodeName ?? "—");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _park = await ParkApiClient.GetByIdAsync(Id);
            if (_park == null)
            {
                _errorMessage = "El parque solicitado no existe.";
                return;
            }

            if (_park.Status != "Activo")
            {
                _infoMessage = "El parque se encuentra inactivo.";
                return;
            }

            var snapshot = await ParkApiClient.GetPanelHealthAsync(Id);
            if (snapshot == null)
            {
                _errorMessage = "El parque solicitado no existe.";
                return;
            }

            _snapshot = snapshot;
            _summary = snapshot.Summary;
            _panelsById = snapshot.Nodes.SelectMany(n => n.Panels).ToDictionary(p => p.PanelId);
            _lastUpdateUtc = snapshot.TimestampUtc;

            if (_panelsById.Count == 0)
            {
                _infoMessage = "No hay paneles registrados en este parque para generar el mapa de salud.";
                return;
            }

            _isLive = true;
            _isLoading = false;
            await InitializeSignalRAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cargando el mapa de salud del parque {ParkId}", Id);
            _errorMessage = $"Error al cargar el mapa de salud: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task InitializeSignalRAsync()
    {
        try
        {
            var apiBaseUrl = Configuration["services:apiservice:https:0"]
                ?? Configuration["services:apiservice:http:0"]
                ?? "http://apiservice";
            var hubUrl = $"{apiBaseUrl.TrimEnd('/')}/hubs/park-health";

            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.HttpMessageHandlerFactory = _ => HttpMessageHandlerFactory.CreateHandler();
                    options.AccessTokenProvider = async () =>
                    {
                        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                        var key = UserTokenStore.GetKey(authState.User);
                        if (key == null) return null;
                        return await TokenService.GetValidAccessTokenAsync(key, CancellationToken.None);
                    };
                })
                .WithAutomaticReconnect(new[] { TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10) })
                .Build();

            _hubConnection.On<ParkHealthUpdateDto>("ReceiveParkHealth", update =>
            {
                if (update.ParkId != Id)
                {
                    return;
                }

                // RF-5: se actualizan las lecturas de las celdas ya dibujadas y los contadores.
                foreach (var reading in update.Panels)
                {
                    if (_panelsById.TryGetValue(reading.PanelId, out var panel))
                    {
                        panel.Reading = reading;
                    }
                }

                _summary = update.Summary;
                _lastUpdateUtc = update.TimestampUtc;
                InvokeAsync(StateHasChanged);
            });

            _hubConnection.Reconnecting += error =>
            {
                Logger.LogWarning(error, "SignalR reconectando para el mapa de salud del parque {ParkId}", Id);
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            _hubConnection.Reconnected += async connectionId =>
            {
                Logger.LogInformation("SignalR reconectado ({ConnectionId}). Re-suscribiendo al parque {ParkId}", connectionId, Id);
                await _hubConnection.InvokeAsync("SubscribeToPark", Id);
                await InvokeAsync(StateHasChanged);
            };

            _hubConnection.Closed += error =>
            {
                Logger.LogWarning(error, "SignalR desconectado para el mapa de salud del parque {ParkId}", Id);
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("SubscribeToPark", Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error conectando al hub SignalR del mapa de salud del parque {ParkId}", Id);
        }
    }

    private void SelectPanel(Guid panelId)
    {
        _selectedPanelId = panelId;
    }

    private static string StateCss(PanelHealthState state) => state switch
    {
        PanelHealthState.Normal => "state-normal",
        PanelHealthState.Degraded => "state-degraded",
        PanelHealthState.Critical => "state-critical",
        PanelHealthState.NoSun => "state-nosun",
        _ => "state-inactive"
    };

    private static string StateLabel(PanelHealthState state) => state switch
    {
        PanelHealthState.Normal => "Óptimo / Normal",
        PanelHealthState.Degraded => "Degradado / Alerta",
        PanelHealthState.Critical => "Falla Crítica",
        PanelHealthState.NoSun => "Sin sol",
        _ => "Inactivo / Sin lecturas"
    };

    private static string FormatPower(double? powerW) => powerW is { } p ? $"{p:0.0} W" : "—";

    private static string FormatEfficiency(PanelHealthReadingDto reading) =>
        reading.EstimatedEfficiencyPercent is { } e ? $"{e:0.0} %" : "—";

    private static string FormatLastMaintenance(DateTime? utc)
    {
        if (utc is not { } value)
        {
            return "Sin mantenimientos";
        }

        foreach (var id in UruguayTimeZoneIds)
        {
            if (TimeZoneInfo.TryFindSystemTimeZoneById(id, out var timeZone) && timeZone != null)
            {
                var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value, DateTimeKind.Utc), timeZone);
                return local.ToString("dd/MM/yyyy HH:mm");
            }
        }

        return value.AddHours(-3).ToString("dd/MM/yyyy HH:mm");
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            try
            {
                if (_hubConnection.State == HubConnectionState.Connected)
                {
                    // RF-7: desuscribirse del grupo del parque al abandonar la pantalla.
                    await _hubConnection.InvokeAsync("UnsubscribeFromPark", Id);
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Error cerrando suscripción SignalR para el mapa de salud del parque {ParkId}", Id);
            }
            finally
            {
                await _hubConnection.DisposeAsync();
            }
        }
    }
}
