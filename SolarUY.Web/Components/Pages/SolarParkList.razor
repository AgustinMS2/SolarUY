@page "/parques"
@rendermode InteractiveServer
@attribute [Authorize]
@inject SolarParkApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Listado de Parques Solares — SolarUY</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-primary d-flex align-items-center">
                <span class="bi bi-sun-fill me-2" aria-hidden="true"></span>
                Parques Solares
            </h1>
            <p class="text-muted mb-0">Gestión y estado operativo de parques fotovoltaicos.</p>
        </div>
        <div>
            <a href="/parques/nuevo" class="btn btn-primary d-flex align-items-center">
                <span class="bi bi-plus-circle me-1" aria-hidden="true"></span>
                <span>Nuevo parque</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Mensaje))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <span class="bi bi-check-circle-fill me-2"></span>
            <div>@Mensaje</div>
            <button type="button" class="btn-close" @onclick="() => Mensaje = null" aria-label="Cerrar"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_actionErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <span class="bi bi-exclamation-triangle-fill me-2"></span>
            <div>@_actionErrorMessage</div>
            <button type="button" class="btn-close" @onclick="() => _actionErrorMessage = null" aria-label="Cerrar"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary me-2" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <span class="text-muted">Cargando listado de parques...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center">
                <span class="bi bi-exclamation-triangle-fill me-2 fs-5"></span>
                <div>@_errorMessage</div>
            </div>
            <button class="btn btn-outline-danger btn-sm" @onclick="LoadParksAsync">
                <span class="bi bi-arrow-clockwise me-1"></span> Reintentar
            </button>
        </div>
    }
    else if (_parks == null || _parks.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="mb-3 text-muted">
                    <span class="bi bi-inbox fs-1" aria-hidden="true"></span>
                </div>
                <h5 class="card-title text-secondary">No hay parques registrados.</h5>
                <p class="card-text text-muted mb-4">Comienza agregando el primer parque solar al sistema.</p>
                <a href="/parques/nuevo" class="btn btn-outline-primary">
                    <span class="bi bi-plus-circle me-1"></span> Registrar Parque
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">Nombre</th>
                            <th scope="col">Latitud</th>
                            <th scope="col">Longitud</th>
                            <th scope="col">Capacidad máxima (kW)</th>
                            <th scope="col">Umbral de alerta (kW)</th>
                            <th scope="col" class="text-center">Estado</th>
                            <th scope="col" class="pe-3 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var park in _parks)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold text-dark">@park.Name</td>
                                <td>@park.Latitude.ToString("F4")</td>
                                <td>@park.Longitude.ToString("F4")</td>
                                <td>@($"{park.MaxCapacityKw:0.##} kW")</td>
                                <td>@($"{park.PowerAlertThresholdKw:0.##} kW")</td>
                                <td class="text-center">
                                    @if (park.Status == "Activo")
                                    {
                                        <span class="badge bg-success px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    <a href="/parques/@park.Id/editar" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center">
                                        <span class="bi bi-pencil me-1"></span> Editar
                                    </a>
                                    @if (park.Status == "Activo")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center ms-1" @onclick="() => RequestDeactivate(park)">
                                            <span class="bi bi-trash me-1"></span> Dar de baja
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_parkToDeactivate != null)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0, 0, 0, 0.5);" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content shadow">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar baja</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelDeactivate"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">¿Confirmás la baja del parque "@_parkToDeactivate.Name"?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDeactivate" disabled="@_isDeactivating">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDeactivateAsync" disabled="@_isDeactivating">
                            @if (_isDeactivating)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            Confirmar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "mensaje")]
    public string? Mensaje { get; set; }

    private IReadOnlyList<SolarParkDto>? _parks;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _actionErrorMessage;

    private SolarParkDto? _parkToDeactivate;
    private bool _isDeactivating;

    protected override async Task OnInitializedAsync()
    {
        await LoadParksAsync();
    }

    private void RequestDeactivate(SolarParkDto park)
    {
        _parkToDeactivate = park;
        _actionErrorMessage = null;
    }

    private void CancelDeactivate()
    {
        _parkToDeactivate = null;
    }

    private async Task ConfirmDeactivateAsync()
    {
        if (_parkToDeactivate == null || _isDeactivating)
        {
            return;
        }

        _isDeactivating = true;
        _actionErrorMessage = null;

        try
        {
            var response = await ApiClient.DeactivateAsync(_parkToDeactivate.Id);
            if (response.Success)
            {
                Mensaje = "Parque dado de baja correctamente.";
                _parkToDeactivate = null;
                await LoadParksAsync();
            }
            else
            {
                _actionErrorMessage = response.ErrorMessage;
                _parkToDeactivate = null;
                await LoadParksAsync();
            }
        }
        catch (Exception ex)
        {
            _actionErrorMessage = $"Error inesperado: {ex.Message}";
            _parkToDeactivate = null;
        }
        finally
        {
            _isDeactivating = false;
        }
    }

    private async Task LoadParksAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _parks = await ApiClient.GetAllAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo cargar el listado de parques. Intentá nuevamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
