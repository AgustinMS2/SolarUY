@page "/nodos/{Id:guid}/editar"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using SolarUY.ApiService.Dtos
@using SolarUY.ApiService.Services
@inject SolarNodeApiClient NodeApiClient
@inject NavigationManager NavManager

<PageTitle>Modificar Nodo — SolarUY</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            @if (_isLoading)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary me-2" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <span class="text-muted">Cargando datos del nodo...</span>
                </div>
            }
            else if (_notFound)
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <div class="mb-3 text-warning">
                            <span class="bi bi-exclamation-circle fs-1" aria-hidden="true"></span>
                        </div>
                        <h5 class="card-title text-secondary">El nodo solicitado no existe.</h5>
                        <p class="card-text text-muted mb-4">El identificador proporcionado no corresponde a ningún nodo registrado.</p>
                        <a href="/nodos" class="btn btn-outline-primary">
                            <span class="bi bi-arrow-left me-1"></span> Volver al listado
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                        <h3 class="card-title h5 mb-0 d-flex align-items-center">
                            <span class="bi bi-pencil-square me-2" aria-hidden="true"></span>
                            Modificar Nodo
                        </h3>
                        @if (!string.IsNullOrEmpty(_status))
                        {
                            <span class="badge @(_status == "Activo" ? "bg-success" : "bg-secondary")">
                                Estado: @_status
                            </span>
                        }
                    </div>
                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                                <span class="bi bi-exclamation-triangle-fill me-2"></span>
                                <div>@_errorMessage</div>
                                <button type="button" class="btn-close" @onclick="() => _errorMessage = null" aria-label="Cerrar"></button>
                            </div>
                        }

                        <EditForm Model="@_formModel" OnValidSubmit="HandleSubmitAsync">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="nodeName" class="form-label fw-semibold">Nombre del Nodo <span class="text-danger">*</span></label>
                                <InputText id="nodeName" class="form-control" placeholder="Ej: Nodo Principal" @bind-Value="_formModel.Name" />
                                <ValidationMessage For="@(() => _formModel.Name)" class="text-danger small mt-1" />
                                <div class="form-text small">Hasta 100 caracteres, único dentro del parque solar.</div>
                            </div>

                            <div class="mb-4">
                                <label for="solarPark" class="form-label fw-semibold">Parque Solar</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <span class="bi bi-lock" aria-hidden="true"></span>
                                    </span>
                                    <input id="solarPark" class="form-control bg-light" value="@_parkName" readonly aria-readonly="true" />
                                </div>
                                <div class="form-text small">El parque solar asociado no puede modificarse.</div>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <a href="/nodos" class="btn btn-outline-secondary px-3">
                                    Cancelar
                                </a>
                                <button type="submit" class="btn btn-primary px-4 d-flex align-items-center" disabled="@_isSubmitting">
                                    @if (_isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Guardando...</span>
                                    }
                                    else
                                    {
                                        <span class="bi bi-save me-1" aria-hidden="true"></span>
                                        <span>Guardar cambios</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private NodeEditFormModel _formModel = new();
    private bool _isLoading = true;
    private bool _notFound;
    private bool _isSubmitting;
    private string? _errorMessage;
    private string _parkName = string.Empty;
    private string? _status;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _notFound = false;
        _errorMessage = null;

        try
        {
            var result = await NodeApiClient.GetByIdAsync(Id);

            if (!result.Success || result.Value == null)
            {
                if (result.ErrorType == ServiceErrorType.NotFound)
                {
                    _notFound = true;
                }
                else
                {
                    _errorMessage = result.ErrorMessage ?? "No se pudo cargar el nodo.";
                }

                return;
            }

            _parkName = result.Value.SolarParkName;
            _status = result.Value.Status;
            _formModel = new NodeEditFormModel { Name = result.Value.Name };
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al cargar el nodo: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var request = new UpdateSolarNodeRequest(_formModel.Name ?? string.Empty);
            var result = await NodeApiClient.UpdateAsync(Id, request);

            if (result.Success)
            {
                NavManager.NavigateTo($"/nodos?mensaje={Uri.EscapeDataString("Nodo actualizado correctamente.")}");
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ocurrió un error inesperado: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class NodeEditFormModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede superar los 100 caracteres.")]
        public string? Name { get; set; }
    }
}
