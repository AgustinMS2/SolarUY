@using SolarUY.Web.Security
<script type="module" src="@Assets["Components/Layout/NavMenu.razor.js"]"></script>

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid d-flex align-items-center">
        <a class="navbar-brand d-flex align-items-center text-white fw-bold py-1" href="">
            <span class="brand-icon me-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-sun-fill" aria-hidden="true"></i>
            </span>
            <div class="d-flex flex-column lh-1">
                <span class="fs-5 brand-text">SolarUY</span>
                <span class="brand-subtext text-uppercase">Plataforma Solar</span>
            </div>
        </a>
    </div>
</div>

<input type="checkbox" title="Menú de navegación" class="navbar-toggler" aria-label="Abrir menú de navegación" />

<div id="nav-scrollable" class="nav-scrollable">
    <nav class="nav flex-column py-2" aria-label="Navegación principal">
        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill nav-icon" aria-hidden="true"></i>
                <span class="nav-label">Inicio</span>
            </NavLink>
        </div>

        <!-- Grupo Operación -->
        <div class="nav-section-title px-3 pt-3 pb-1 text-uppercase">
            <span>Operación & Campo</span>
        </div>

        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="mis-mantenimientos" Match="NavLinkMatch.All">
                <i class="bi bi-tools nav-icon text-warning" aria-hidden="true"></i>
                <span class="nav-label">Mis Mantenimientos</span>
                <span class="badge badge-accent ms-auto">Campo</span>
            </NavLink>
        </div>

        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="mantenimientos" Match="NavLinkMatch.All">
                <i class="bi bi-calendar-check-fill nav-icon" aria-hidden="true"></i>
                <span class="nav-label">Mantenimientos</span>
            </NavLink>
        </div>

        <!-- Grupo Infraestructura Solar -->
        <div class="nav-section-title px-3 pt-3 pb-1 text-uppercase">
            <span>Infraestructura</span>
        </div>

        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="parques" Match="NavLinkMatch.All">
                <i class="bi bi-grid-fill nav-icon" aria-hidden="true"></i>
                <span class="nav-label">Parques Solares</span>
            </NavLink>
        </div>

        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="nodos" Match="NavLinkMatch.All">
                <i class="bi bi-diagram-3-fill nav-icon" aria-hidden="true"></i>
                <span class="nav-label">Nodos</span>
            </NavLink>
        </div>

        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="paneles" Match="NavLinkMatch.All">
                <i class="bi bi-grid-3x3 nav-icon" aria-hidden="true"></i>
                <span class="nav-label">Paneles</span>
            </NavLink>
        </div>

        <!-- Grupo Gestión (solo Administrador) -->
        <AuthorizeView Roles="@AppRoles.Administrator">
            <div class="nav-section-title px-3 pt-3 pb-1 text-uppercase">
                <span>Gestión</span>
            </div>

            <div class="nav-item px-3 mb-1">
                <NavLink class="nav-link" href="tecnicos" Match="NavLinkMatch.All">
                    <i class="bi bi-person-badge-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-label">Técnicos</span>
                </NavLink>
            </div>

            <div class="nav-item px-3 mb-1">
                <NavLink class="nav-link" href="usuarios" Match="NavLinkMatch.All">
                    <i class="bi bi-people-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-label">Usuarios & Roles</span>
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>
